# Batch Processor Configuration
# Transactions Per Second (How many calls to the server every second)
BATCH_TPS=2

# Maximum time to wait for a response from the SOAP server (in milliseconds)
BATCH_TIMEOUT=30000

# Concurrency (1 = sequence, >1 = concurrent)
BATCH_BURST=1

# Off-Peak Hours (00:01 to 04:00 by default)
BATCH_OFF_PEAK_TPS=10
BATCH_OFF_PEAK_START=00:01
BATCH_OFF_PEAK_END=04:00
